# ---- Simulation service (apps/worker) ----
# PostgreSQL connection (Supabase: Settings → Database → connection string, service role / postgres user).
# Leave empty to use the embedded PGlite database in apps/worker/.data/pglite (local development only).
DATABASE_URL=
# Optional Redis for rate limiting + multi-instance pub/sub fan-out. Empty = in-memory.
REDIS_URL=
# Required in production
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me
# Optional: OpenAI decision-making + diary writing. Empty = deterministic utility brain (labelled as such).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_CALLS_PER_HOUR=120
LLM_DAILY_BUDGET_USD=2
LLM_MIN_INTERVAL_SEC=20
# simulated seconds per real second (30 → one simulated day every 48 real minutes)
TIME_SCALE=30
TICK_MS=1000
PORT=4000
CORS_ORIGINS=http://localhost:3000

# ---- Website (apps/web) ----
# Where Next.js proxies /api/* (server-side only)
WORKER_URL=http://localhost:4000
# WebSocket URL browsers connect to (defaults to ws://<current host>:4000/ws)
NEXT_PUBLIC_WS_URL=
